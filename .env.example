# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI (used by all agents)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Serper.dev — powers LinkBot backlink search (real Google results)
# Get a free key at https://serper.dev — includes 2,500 free queries
# NOTE: replaces Google PSE which no longer supports full-web search for new engines
SERPER_API_KEY=your_serper_api_key_here

# Resend — transactional email (agent reports)
RESEND_API_KEY=re_your-resend-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Price IDs
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_GROWTH_PRICE_ID=price_growth_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# Cron job authentication
CRON_SECRET=your-random-secret-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RankMind AI
